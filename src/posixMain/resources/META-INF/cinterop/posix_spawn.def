package = borg.trikeshed.userspace.nio.posix
headers = spawn.h unistd.h fcntl.h sys/types.h sys/stat.h signal.h errno.h string.h dirent.h stdlib.h stdio.h
headers.osx = sys/random.h
compilerOpts.linux = -D_GNU_SOURCE

---

extern char **environ;

// std::env::args_os on glibc: argc and argv kept by an initializer, which glibc's .init_array (and dyld) calls with
// argc, argv and envp, so arguments that are not UTF-8 reach Kotlin as their bytes.
static int trikeshed_argc;
static char **trikeshed_argv;
__attribute__((constructor)) static void trikeshed_args_init(int argc, char **argv, char **envp) {
    trikeshed_argc = argc;
    trikeshed_argv = argv;
}
static inline char **trikeshed_args(int *argc) {
    *argc = trikeshed_argc;
    return trikeshed_argv;
}

// open(2) of a path as its bytes: cinterop hands a `const char *` parameter a Kotlin String, which a path that is not
// UTF-8 (one from args_os) cannot be.
static inline int trikeshed_open(char *path, int flags, int mode) {
    return open(path, flags, mode);
}

// OFD record locks conflict with ordinary fcntl locks (including JVM FileLock),
// but belong to this descriptor, not every descriptor opened by this process.
// Closing a rejected contender therefore cannot release the active writer.
static inline int trikeshed_file_lease(const char *path) {
#ifdef F_OFD_SETLK
    int fd = open(path, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
    if (fd < 0) return -1;
    struct flock lock;
    memset(&lock, 0, sizeof lock);
    lock.l_type = F_WRLCK;
    lock.l_whence = SEEK_SET;
    int status;
    do { status = fcntl(fd, F_OFD_SETLK, &lock); } while (status < 0 && errno == EINTR);
    if (status == 0) return fd;
    int failure = errno;
    close(fd);
    errno = failure;
#else
    errno = ENOTSUP;
#endif
    return -1;
}

// Keep the platform's opaque pointer/struct ABI inside the C boundary.
static inline int trikeshed_spawn(pid_t *pid, const char *input,
        const char *output, const char *error, char *const argv[]) {
    posix_spawn_file_actions_t actions;
    int status = posix_spawn_file_actions_init(&actions);
    if (status != 0) return status;
    if (input != NULL)
        status = posix_spawn_file_actions_addopen(&actions, STDIN_FILENO, input, O_RDONLY, 0);
    if (status == 0)
        status = posix_spawn_file_actions_addopen(&actions, STDOUT_FILENO, output, O_WRONLY | O_TRUNC, 0600);
    if (status == 0)
        status = posix_spawn_file_actions_addopen(&actions, STDERR_FILENO, error, O_WRONLY | O_TRUNC, 0600);
    if (status == 0)
        status = posix_spawnp(pid, argv[0], &actions, NULL, argv, environ);
    posix_spawn_file_actions_destroy(&actions);
    return status;
}

// std::process::Command's spawn for a supervised child: stdio and environment inherited, a process group of its own
// (process_group(0)), an empty signal mask and SIGPIPE at its default. The child keeps stdio alone, as from a Rust parent
// whose descriptors are all O_CLOEXEC: Darwin's POSIX_SPAWN_CLOEXEC_DEFAULT; on glibc, which has no closefrom action
// before 2.34, a close action for every descriptor above stderr in /proc/self/fd (glibc ignores the action of one
// closed meanwhile; one opened meanwhile without O_CLOEXEC is inherited).
static inline int trikeshed_spawn_group(pid_t *pid, char *const argv[]) {
    posix_spawnattr_t attributes;
    posix_spawn_file_actions_t actions;
    sigset_t mask, defaults;
    short flags = POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSIGDEF;
    int status = posix_spawnattr_init(&attributes);
    if (status != 0) return status;
    status = posix_spawn_file_actions_init(&actions);
    if (status != 0) {
        posix_spawnattr_destroy(&attributes);
        return status;
    }
#ifdef POSIX_SPAWN_CLOEXEC_DEFAULT
    flags |= POSIX_SPAWN_CLOEXEC_DEFAULT;
    for (int fd = 0; fd < 3 && status == 0; fd++) status = posix_spawn_file_actions_addinherit_np(&actions, fd);
#else
    DIR *descriptors = opendir("/proc/self/fd");
    if (descriptors == NULL) status = errno;
    else {
        struct dirent *entry;
        while (status == 0 && (entry = readdir(descriptors)) != NULL) {
            char *end;
            long fd = strtol(entry->d_name, &end, 10);
            if (end != entry->d_name && *end == 0 && fd > 2 && fd != dirfd(descriptors))
                status = posix_spawn_file_actions_addclose(&actions, (int) fd);
        }
        closedir(descriptors);
    }
#endif
    sigemptyset(&mask);
    sigemptyset(&defaults);
    sigaddset(&defaults, SIGPIPE);
    if (status == 0) status = posix_spawnattr_setflags(&attributes, flags);
    if (status == 0) status = posix_spawnattr_setpgroup(&attributes, 0);
    if (status == 0) status = posix_spawnattr_setsigmask(&attributes, &mask);
    if (status == 0) status = posix_spawnattr_setsigdefault(&attributes, &defaults);
    if (status == 0) status = posix_spawnp(pid, argv[0], &actions, &attributes, argv, environ);
    posix_spawn_file_actions_destroy(&actions);
    posix_spawnattr_destroy(&attributes);
    return status;
}

// SIGTERM, SIGINT and SIGHUP, each delivery written as one byte by an async-signal-safe handler to a pipe.
static int trikeshed_signal_fds[2] = {-1, -1};

static void trikeshed_signal_write(int signum) {
    int saved = errno;
    unsigned char value = (unsigned char) signum;
    (void) write(trikeshed_signal_fds[1], &value, 1);
    errno = saved;
}

/** The pipe's read end once the handlers are installed, or -1. */
static inline int trikeshed_signal_pipe(void) {
    struct sigaction action;
    if (trikeshed_signal_fds[0] >= 0) return trikeshed_signal_fds[0];
    if (pipe(trikeshed_signal_fds) != 0) return -1;
    // A full pipe drops a delivery rather than block the handler; neither end reaches an exec'd program.
    if (fcntl(trikeshed_signal_fds[1], F_SETFL, O_NONBLOCK) != 0 || fcntl(trikeshed_signal_fds[0], F_SETFD, FD_CLOEXEC) != 0 ||
        fcntl(trikeshed_signal_fds[1], F_SETFD, FD_CLOEXEC) != 0) return -1;
    memset(&action, 0, sizeof action);
    action.sa_handler = trikeshed_signal_write;
    sigemptyset(&action.sa_mask);
    action.sa_flags = SA_RESTART;
    if (sigaction(SIGTERM, &action, NULL) != 0 || sigaction(SIGINT, &action, NULL) != 0 || sigaction(SIGHUP, &action, NULL) != 0)
        return -1;
    return trikeshed_signal_fds[0];
}

static inline long long trikeshed_last_modified(const char *path) {
    struct stat value;
    if (stat(path, &value) != 0) return 0;
#ifdef __APPLE__
    return (long long)value.st_mtimespec.tv_sec * 1000 + value.st_mtimespec.tv_nsec / 1000000;
#else
    return (long long)value.st_mtim.tv_sec * 1000 + value.st_mtim.tv_nsec / 1000000;
#endif
}
