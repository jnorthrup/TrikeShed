{
  "schema": "trikeshed.hermes-wikiskill-trainer/v1",
  "setId": "1A",
  "resourceRoot": "hermes/wiki-trainer/1A",
  "designAuthority": {
    "title": "WikiSkill: Compiling Agent Experience into Persistent Knowledge for Skill Evolution",
    "arxiv": "2608.27454v1",
    "url": "https://arxiv.org/abs/2608.27454",
    "role": "architecture authority; paper benchmark scores are not local 1A results"
  },
  "pipeline": [
    "immutable-hermes-transcript",
    "corenlp-indexed-dependencies",
    "brainclient-modelmux-bidirectional-nlpcore-nars-translation",
    "deterministic-causal-projection",
    "nars-evidence-budget",
    "persistent-wiki-pattern",
    "one-atomic-skill-candidate",
    "disjoint-validation-gate"
  ],
  "invariants": [
    "raw transcript bytes are immutable and addressed by sha256",
    "a causal edge must cite an exact transcript cid and source span",
    "subject and object direction must match indexed CoreNLP dependencies",
    "BrainClient through ModelMux translates NLPCore to and from NARS proposals",
    "BrainClient and ModelMux translate but do not create evidence authority",
    "co-occurrence is not causation",
    "an LLM may propose but cannot admit a causal edge",
    "the wiki persists when a candidate skill is rejected",
    "a candidate skill is not active until validation improves the incumbent score"
  ],
  "sampling": {
    "maximumTraces": 8,
    "train": { "pass": 1, "fail": 1 },
    "validation": { "pass": 1, "fail": 1 },
    "disjointSplits": true,
    "maximumCharactersPerTrace": 15000
  },
  "traces": [
