LOGO=$(logo_b64 | tr -d '\n')
GFX_C=10 GFX_R=$HDR
if [ "$gfx_mode" = kitty ]; then TEXT_COL=$((GFX_C+3)); else TEXT_COL=3; fi

# ---- cmux backend: native sidebar/notifications/splits instead of the drawn header
if [ "$LAYOUT" = cmux ]; then
  PREVH= LASTKEY=
  mx_push() {
    poll_status "$STATUS"
    hs=$(stat_get health "$STATUS"); sq=$(stat_get seq "$STATUS"); cl=$(stat_get cols "$STATUS")
    if [ -n "$DPID" ] && ! kill -0 "$DPID" 2>/dev/null; then txt="daemon exited" col='#ff5f5f'
    elif [ "$hs" = ok ]; then txt="up seq $sq" col='#5fd787'
    else txt="down" col='#ff5f5f'; fi
    key="$txt|$cl"
    if [ "$key" != "$LASTKEY" ]; then
      LASTKEY=$key
      mx set-status oroboros "$MODE :$PORT $txt" --color "$col" >/dev/null
      nz=$(printf '%s' "$cl" | tr ' ' '\n' | grep -v ':0$' | tr '\n' ' ')
      [ -n "$nz" ] && mx set-status oroboros_board "$nz" --color '#8aa4ff' >/dev/null
      prog=$(printf '%s' "$cl" | tr ' ' '\n' | awk -F: 'NF==2 && $1!="archived"{t+=$2} $1=="done"{d=$2} END{if(t>0) printf "%.2f %d/%d", d/t, d, t}')
      [ -n "$prog" ] && mx set-progress "${prog%% *}" --label "${prog#* } done" >/dev/null
    fi
    if [ -n "$PREVH" ] && [ "$PREVH" != "$txt" ]; then   # transitions only
      mx log --source oroboros "$txt (was $PREVH)" >/dev/null
      case $txt in down|daemon*) mx notify --title oroboros --body "$txt at $URL" >/dev/null;; esac
    fi
    PREVH=$txt
    if [ "$hs" = ok ] && [ "$NOBROWSER" = 0 ] && [ ! -e "$STATE/browser.ref" ]; then
      out=$(mx browser open "$URL/" --focus false)
      r=$(printf '%s' "$out" | grep -o 'surface:[0-9][0-9]*' | head -n 1)
      printf '%s\n' "${r:-opened}" >"$STATE/browser.ref"
    fi
  }
  [ "$MODE" = start ] && start_daemon "$@"
  mx rename-workspace "oroboros :$PORT" >/dev/null
  if [ "$MODE" = start ] && [ -n "$SHBIN" ]; then
    out=$(mx new-split down --command "exec tail -n 200 -f $(q "$LOG")")
    printf '%s\n' "$(printf '%s' "$out" | grep -o 'surface:[0-9][0-9]*' | head -n 1)" >"$STATE/logsplit.ref"
  fi
  mx_push
  PARENT=$$
  ( while kill -0 "$PARENT" 2>/dev/null; do sleep 3; mx_push; done ) &
  UPD=$!
  if [ "$gfx_mode" = kitty ]; then   # logo inline above the prompt (the ghostty/kitty surface renders it)
    printf '\n\n\n\n\n\033[5A\033_Ga=T,f=100,t=d,i=%d,p=2,c=%d,r=%d,C=1,q=2;%s\033\\\033[5B' "$GFX_ID" "$GFX_C" "$GFX_R" "$LOGO"
  fi
  printf '\033[1;38;5;114moroboros\033[0m  %s  (%s)\n' "$URL" "$MODE"
  run_lower
  exit $RC
fi

# ---- drawing ----------------------------------------------------------------
UTF=0; case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) UTF=1;; esac
if [ $UTF = 1 ]; then BAR=━ DOT=● OFF=○; else BAR=- DOT='*' OFF=o; fi

fit() { printf '%s' "$1" | tr -cd '[:print:]' | cut -c1-"$2"; }
put() { printf '\033[%d;%dH\033[K%s' "$1" "$2" "$3"; }   # row col text

draw_divider() {
  label=" oroboros $MODE :$PORT $DIV_LABEL "
  pre=; i=0; while [ $i -lt 3 ]; do pre="$pre$BAR"; i=$((i+1)); done
  rest=$((COLS-3-${#label})); post=; i=0
  while [ $i -lt "$rest" ]; do post="$post$BAR"; i=$((i+1)); done
  printf '\033[%d;1H\033[38;5;71m%s\033[1;38;5;114m%s\033[0;38;5;71m%s\033[0m' \
    $((HDR+1)) "$pre" "$label" "$post"
}

draw_header() {
  w=$((COLS-TEXT_COL-8)); [ $w -lt 4 ] && w=4
  hs=$(stat_get health "$STATUS")
  case $hs in
    ok) dot="\033[38;5;114m$DOT up\033[0m";;
    '') dot="\033[38;5;179m$OFF polling\033[0m";;
    *)  dot="\033[38;5;203m$OFF down\033[0m";;
  esac
  if [ -n "$DPID" ]; then
    if kill -0 "$DPID" 2>/dev/null; then who="started, pid $DPID"; else who="\033[38;5;203mdaemon exited\033[0m"; fi
  else who="attached"; fi
  up=$(( $(date +%s) - START ))
  put 1 "$TEXT_COL" "$(printf '\033[1;38;5;114moroboros\033[0m  %b  %b  \033[2m%ds\033[0m' "$dot" "$who" "$up")"
  put 2 "$TEXT_COL" "$(printf '\033[2mboard\033[0m  %s  seq %s' "$(fit "$URL" $((w-12)))" "$(stat_get seq "$STATUS")")"
  put 3 "$TEXT_COL" "$(printf '\033[2mcols \033[0m  %s' "$(fit "$(stat_get cols "$STATUS")" $w)")"
  if [ -n "$DPID" ]; then last=waiting; [ -s "$LOG" ] && last=$(tail -n 1 "$LOG" 2>/dev/null)
    put 4 "$TEXT_COL" "$(printf '\033[2mlog  \033[0m  %s' "$(fit "$last" $w)")"
  else
    put 4 "$TEXT_COL" "$(printf '\033[2mtitle\033[0m  %s' "$(fit "$(stat_get title "$STATUS")" $w)")"
  fi
  put 5 "$TEXT_COL" "$(printf '\033[2m%s\033[0m' "$(fit "term $TERM_OUT  gfx $gfx_mode  shell ${SHBIN##*/}${SSH_CONNECTION:+  ssh}" $((w+8)))")"
}

gfx_place() {  # transmit once (send) or just re-place
  [ "$gfx_mode" = kitty ] || return 0
  printf '\033[1;1H'
  if [ "$1" = send ]; then
    printf '\033_Ga=T,f=100,t=d,i=%d,p=1,c=%d,r=%d,C=1,q=2;%s\033\\' "$GFX_ID" "$GFX_C" "$GFX_R" "$LOGO"
  else
    printf '\033_Ga=p,i=%d,p=1,c=%d,r=%d,C=1,q=2\033\\' "$GFX_ID" "$GFX_C" "$GFX_R"
  fi
}

layout() {  # $1 = send|place
  printf '\0337'
  gfx_place "$1"
  draw_header; draw_divider
  printf '\033[%d;%dr' $((HDR+2)) "$ROWS"   # scroll region = lower pane
  printf '\0338'
}

# ---- run --------------------------------------------------------------------
[ "$MODE" = start ] && start_daemon "$@"
if [ -n "$SHBIN" ]; then DIV_LABEL="│ ${SHBIN##*/}"; [ $UTF = 1 ] || DIV_LABEL="- ${SHBIN##*/}"; else DIV_LABEL="foreground"; fi

poll_status "$STATUS" &   # first paint without waiting a full tick
wait $!
printf '\033]0;oroboros\007\033[2J\033[H'
layout send
printf '\033[%d;1H' $((HDR+2))

PARENT=$$
(
  tick=0; lr=$ROWS; lc=$COLS
  while kill -0 "$PARENT" 2>/dev/null; do
    sleep 1; tick=$((tick+1))
    sz=$(stty size </dev/tty 2>/dev/null); ROWS=${sz%% *}; COLS=${sz##* }   # bg jobs get stdin=/dev/null
    case $ROWS$COLS in *[!0-9]*|'') continue;; esac
    [ $((tick % 3)) -eq 0 ] && poll_status "$STATUS"
    if [ "$ROWS" != "$lr" ] || [ "$COLS" != "$lc" ]; then
      lr=$ROWS lc=$COLS; layout send
    else
      layout place
    fi
  done
) &
UPD=$!

run_lower
exit $RC
