#!/bin/bash
# oroboros-up — nothing to a working board, in one command.
#
#   bin/oroboros-up                 # reused scratch home, first free port from 8888
#   bin/oroboros-up --home ~/.local/forge
#   bin/oroboros-up --port 8899 --open
#
# Why this exists: the documented path was "gradlew jvmMainClasses, then run the
# daemon", which quietly produces a daemon serving STALE code, because the
# classpath is build/live/classes and jvmMainClasses does not refresh it. Add a
# port already held by another daemon, a wrapper pid that is not the java
# process, and there were four ways to end up staring at something that looked
# broken and wasn't. This does the whole sequence and refuses to lie about it.
#
# Flags:
#   --home <path>   forge home (default: a REUSED scratch dir under $TMPDIR)
#   --fresh         mint a new per-run scratch home instead of reusing one
#   --port <n>      port to bind (default: first free from 8888)
#   --open          open the board in your browser when it is up
#   --no-build      skip the build step (you know the feed is current)

set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOME_DIR=""
PORT=""
OPEN=0
BUILD=1
FRESH=0
while [ $# -gt 0 ]; do
  case "$1" in
    --home) shift; HOME_DIR="${1:-}" ;;
    --port) shift; PORT="${1:-}" ;;
    --open) OPEN=1 ;;
    --no-build) BUILD=0 ;;
    --fresh) FRESH=1 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) printf 'unknown flag: %s (try --help)\n' "$1"; exit 2 ;;
  esac
  shift
done

step() { printf '\n\033[1m▸ %s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
die()  { printf '  \033[31m✗\033[0m %s\n' "$*"; exit 1; }

step "checking the toolchain"
JV="$(java -version 2>&1 | head -1 | sed -E 's/.*"([0-9]+)\..*/\1/')"
[ "${JV:-0}" -ge 25 ] 2>/dev/null || die "JDK ${JV:-unknown}; the daemon needs 25+ (try: sdk use java 25.0.4.1-graal)"
ok "JDK $JV"

step "picking a port"
if [ -z "$PORT" ]; then
  # 8888 is the operator surface. If something already holds it, DO NOT fight it —
  # a second daemon on someone else's port serves an empty board that looks
  # exactly like their work disappeared.
  for p in 8888 8889 8890 8891 8892 8899; do
    if ! lsof -ti:"$p" >/dev/null 2>&1; then PORT="$p"; break; fi
  done
  [ -n "$PORT" ] || die "8888-8892 and 8899 are all busy; pass --port"
  [ "$PORT" != "8888" ] && printf '  \033[33m!\033[0m 8888 is already in use (another daemon?) — using %s instead\n' "$PORT"
else
  lsof -ti:"$PORT" >/dev/null 2>&1 && die "port $PORT is already held; stop that process or pick another"
fi
ok "port $PORT"

step "forge home"
if [ -z "$HOME_DIR" ]; then
  # A STABLE scratch home, reused across runs. mktemp -d minted a fresh one on
  # every invocation and nothing ever reclaimed it, so a normal debugging
  # session — six restarts in forty minutes — left 9.4G of CAS behind in
  # $TMPDIR and filled the volume. That is not hypothetical: it happened on
  # 2026-08-31, the disk hit 99%, and the JFR writer took the daemon down
  # MID-REQUEST, which reads exactly like a code regression in whatever you
  # touched last. Reusing one path also keeps the CAS warm instead of
  # rebuilding it from nothing on every boot.
  #
  # --fresh restores the old behaviour when a run genuinely needs a clean home.
  if [ "$FRESH" = 1 ]; then
    HOME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/oroboros-home.XXXXXX")"
    printf '  FRESH scratch home (remember to remove it): %s\n' "$HOME_DIR"
  else
    HOME_DIR="${TMPDIR:-/tmp}/oroboros-home"
    mkdir -p "$HOME_DIR" || die "cannot create $HOME_DIR"
    printf '  scratch home, reused (nothing of yours is touched): %s\n' "$HOME_DIR"
  fi
  # Report — never delete — any older per-run homes still lying around.
  STALE="$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'oroboros-home.*' -type d 2>/dev/null | head -20)"
  if [ -n "$STALE" ]; then
    N=$(printf '%s\n' "$STALE" | wc -l | tr -d ' ')
    SZ=$(du -sch $STALE 2>/dev/null | tail -1 | cut -f1)
    printf '  \033[33m!\033[0m %s older per-run scratch home(s) here, %s total — safe to delete:\n' "$N" "$SZ"
    printf '      rm -rf %s/oroboros-home.*\n' "${TMPDIR:-/tmp}"
  fi
else
  mkdir -p "$HOME_DIR" || die "cannot create $HOME_DIR"
  printf '  \033[33m!\033[0m using an EXISTING home — this is production state, not a sandbox\n'
fi
ok "$HOME_DIR"

if [ "$BUILD" = "1" ]; then
  step "building the classpath the daemon actually runs from"
  # hotswapFeed, not jvmMainClasses: build/live/classes is the daemon's classpath
  # and only this task refreshes it.
  if pgrep -f 'GradleDaemon|jvmTest/work' >/dev/null 2>&1; then
    # Gradle serializes on the project lock, so this step sits silent behind any
    # other build. Saying so beats looking hung.
    printf '  another gradle build is running — waiting for the project lock…\n'
  fi
  ( cd "$REPO" && ./gradlew hotswapFeed jvmProcessResources --console=plain -q ) \
    || die "build failed — run ./gradlew hotswapFeed to see why"
  ok "build/live/classes and web resources are current"
fi

step "starting the daemon"
LOG="$HOME_DIR/daemon.log"
# --belief-bag: without it nal.*/beliefs.*/state.freeze answer "belief bag
# disabled", and two gallery presets that advertise "Nothing — it runs as it
# is" (preset-curator, preset-state-freeze) fail on the one path we tell a
# newcomer to use. The onboarding launcher opts in; the daemon default is
# untouched.
( cd "$REPO" && nohup bin/oroboros-daemon --home "$HOME_DIR" --repo "$REPO" --kanban-port "$PORT" --belief-bag >>"$LOG" 2>&1 & )
BASE="http://127.0.0.1:$PORT"
for i in $(seq 1 60); do
  curl -sf -m 2 "$BASE/api/board" >/dev/null 2>&1 && break
  sleep 2
  [ "$i" = "60" ] && { printf '  \033[31m✗\033[0m daemon did not answer within 120s. Last log lines:\n'; tail -20 "$LOG"; exit 1; }
done
ok "daemon answering on $BASE"

step "verifying the surfaces"
curl -sf -m 5 "$BASE/api/board" >/dev/null 2>&1 && ok "board      $BASE/api/board" || die "board route not answering"
if curl -sf -m 5 "$BASE/api/mcp" >/dev/null 2>&1; then
  ok "mcp        $BASE/api/mcp"
else
  printf '  \033[33m!\033[0m /api/mcp not answering — the kanban module may have failed to attach; see %s\n' "$LOG"
fi
curl -sf -m 5 "$BASE/panels" >/dev/null 2>&1 && ok "panels     $BASE/panels" || printf '  ! /panels not answering\n'

cat <<EOF

$(printf '\033[1mup.\033[0m')  home=$HOME_DIR  port=$PORT

  board      $BASE/api/board
  panels     $BASE/panels
  mcp        $BASE/api/mcp

  point an agent at it:
    claude mcp add --transport http oroboros-kanban $BASE/api/mcp

  prove the stack:     bin/mux stack --port $PORT
  prove the board:     scripts/demo-mcp-kanban.sh --evidence proof.json
  when it misbehaves:  scripts/oroboros-doctor.sh --port $PORT
  stop it:             pkill -f "build/live/classes.*--kanban-port $PORT"
  log:                 $LOG
EOF

[ "$OPEN" = "1" ] && command -v open >/dev/null 2>&1 && open "$BASE/panels"
exit 0
