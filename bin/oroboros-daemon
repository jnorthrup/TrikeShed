#!/usr/bin/env bash
# bin/oroboros-daemon — launch the TrikeShed flywheel+modelmux+jules daemon
#
# Classpath layout (no fat jar, no cache glob):
#   build/classes/kotlin/jvm/main      <- naked TrikeShed classes (HotSwapAgent watches this dir)
#   build/staging/lib/*.jar            <- runtime deps staged by `./gradlew stageDaemonLib`
#
# Forwards all flags to OroborosDaemon. Recognized:
#   --once / --watch           run one cycle, or loop forever (default)
#   --interval-ms <N>          poll cadence (default: FlywheelElement.pollIntervalMs)
#   --home <path>              forge home (default: $HOME/.local/forge per ForgeHome.defaultHome)
#   --repo <path>              repo work tree (default: cwd)
#   --debug                    attach JDWP on :5005, suspend=n
#   --suspend                  like --debug but suspend=y (debugger required before main runs)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

LOG_DIR="$ROOT/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/oroboros-daemon.log"

if [[ -f "$LOG_FILE" ]]; then
    for i in {4..1}; do
        if [[ -f "$LOG_FILE.$i" ]]; then
            mv "$LOG_FILE.$i" "$LOG_FILE.$((i+1))"
        fi
    done
    mv "$LOG_FILE" "$LOG_FILE.1"
fi

exec > >(tee -a "$LOG_FILE") 2>&1

CLASSES="$ROOT/build/classes/kotlin/jvm/main"
LIB="$ROOT/build/staging/lib"

if [[ ! -d "$CLASSES" ]]; then
    echo "missing $CLASSES; run: ./gradlew compileKotlinJvm" >&2
    exit 1
fi
if [[ ! -d "$LIB" ]]; then
    echo "missing $LIB; run: ./gradlew stageDaemonLib" >&2
    exit 1
fi

# Wildcard expansion happens after the colon, so we quote it.
CP="$CLASSES:$LIB/*"

WATCH="--watch"
DAEMON_ARGS=()
DEBUG_OPTS=()
HOME_POS=""
REPO_POS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --once)        WATCH="--once"; shift ;;
    --watch)       WATCH="--watch"; shift ;;
    --interval-ms) DAEMON_ARGS+=("--interval-ms" "$2"); shift 2 ;;
    --home)        HOME_POS="$2"; shift 2 ;;
    --repo)        REPO_POS="$2"; shift 2 ;;
    --debug)       DEBUG_OPTS+=("-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"); shift ;;
    --suspend)     DEBUG_OPTS+=("-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005"); shift ;;
    *)             DAEMON_ARGS+=("$1"); shift ;;
  esac
done

# FLYWHEEL_CYCLE_INTERVAL overrides --interval-ms and the daemon default.
# Value is in milliseconds; "2h", "30m", "15m" etc are converted here.
_INTERVAL_MS=""
if [[ -n "${FLYWHEEL_CYCLE_INTERVAL:-}" ]]; then
  case "${FLYWHEEL_CYCLE_INTERVAL}" in
    *h)  _INTERVAL_MS=$(( ${FLYWHEEL_CYCLE_INTERVAL%h} * 3600 * 1000 )) ;;
    *m)  _INTERVAL_MS=$(( ${FLYWHEEL_CYCLE_INTERVAL%m} * 60 * 1000 )) ;;
    *s)  _INTERVAL_MS=$(( ${FLYWHEEL_CYCLE_INTERVAL%s} * 1000 )) ;;
    *ms) _INTERVAL_MS=${FLYWHEEL_CYCLE_INTERVAL%ms} ;;
    *)   _INTERVAL_MS=$FLYWHEEL_CYCLE_INTERVAL ;;
  esac
  DAEMON_ARGS+=("--interval-ms" "$_INTERVAL_MS")
  echo "[oroboros-daemon] FLYWHEEL_CYCLE_INTERVAL=${FLYWHEEL_CYCLE_INTERVAL} -> ${_INTERVAL_MS}ms"
fi

# The daemon takes forgeHome/repoDir as POSITIONAL args (must come last, in
# that order). Passing --repo without --home would put the repo path in the
# forgeHome slot — that bug created the stray ./--repo/ WAL directory.
if [[ -n "$REPO_POS" && -z "$HOME_POS" ]]; then
  HOME_POS="${TRIKESHED_HOME:-$HOME/.local/forge}"
fi

# `-cp "$CP"` must be unquoted shell-side so the wildcard expands.
# shellcheck disable=SC2086
exec java "${DEBUG_OPTS[@]}" -cp $CP borg.trikeshed.daemon.OroborosDaemon $WATCH "${DAEMON_ARGS[@]}" ${HOME_POS:+"$HOME_POS"} ${REPO_POS:+"$REPO_POS"}
