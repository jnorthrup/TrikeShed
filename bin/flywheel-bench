#!/usr/bin/env bash
# bin/flywheel-bench — benchmark each flywheel operation against each jules task
# and record results to benchmarks/flywheel-bench-YYYYMMDD-HHMMSS.jsonl.
#
# Recorded per row: ts, jules_task, flywheel_op, op_metric, value, unit.
#   flywheel_op ∈ {RESEARCH, WORK_CREATION, RANK, DISPATCH, TEND, HARVEST, TDD_GATE, LAND}
#
# Usage:
#   bin/flywheel-bench                    # default: all ops, all jules branches
#   bin/flywheel-bench --ops HARVEST,LAND # restrict ops
#   bin/flywheel-bench --dry              # don't write file, print to stdout
#
# All measurements are real (no fabrication). Off-JVM ops use /usr/bin/time -p.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
BENCH_DIR="$REPO_ROOT/benchmarks"
mkdir -p "$BENCH_DIR"

# ---------- arg parsing ----------
OPS_FILTER="RESEARCH,WORK_CREATION,RANK,DISPATCH,TEND,HARVEST,TDD_GATE,LAND"
DRY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ops) OPS_FILTER="$2"; shift 2 ;;
    --dry) DRY=1; shift ;;
    -h|--help)
      sed -n '2,16p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

ts() { python3 -c 'import time; print(int(time.time()*1000))'; }
now_iso() { python3 -c '
import datetime
now = datetime.datetime.now(datetime.timezone.utc)
ms = int(now.microsecond // 1000)
fmt = now.strftime("%Y-%m-%dT%H:%M:%S.")
print(f"{fmt}{ms:03d}Z")
'; }
ms() { local s=$1 e=$2; echo $(( e - s )); }

# ---------- file location ----------
if [[ $DRY -eq 0 ]]; then
  OUT="$BENCH_DIR/flywheel-bench-$(date +%Y%m%d-%H%M%S).jsonl"
  : > "$OUT"
  echo "# flywheel-bench $(now_iso)" > "$OUT"
  echo "# ops filter: $OPS_FILTER" >> "$OUT"
fi

emit() {
  local jt="$1" op="$2" metric="$3" value="$4" unit="$5"
  local line
  line=$(printf '{"ts":"%s","jules_task":"%s","flywheel_op":"%s","metric":"%s","value":%s,"unit":"%s"}' \
            "$(now_iso)" "$jt" "$op" "$metric" "$value" "$unit")
  if [[ $DRY -eq 0 ]] && [[ -n "${OUT:-}" ]]; then
    echo "$line" >> "$OUT"
  fi
  echo "$line"
}

# ---------- discover jules tasks ----------
# A "jules task" is any local+remote branch whose name starts with "jules-".
mapfile -t JULES_TASKS < <(git for-each-ref --format='%(refname:short)' refs/heads/ refs/remotes/ \
  | awk '/^(origin\/)?jules-[0-9]/ { print; }' | sort -u)
if [[ ${#JULES_TASKS[@]} -eq 0 ]]; then
  echo "no jules tasks found" >&2; exit 1
fi
echo "found ${#JULES_TASKS[@]} jules tasks" >&2

want_op() {
  local op="$1"
  case ",$OPS_FILTER," in *",$op,"*) return 0 ;; *) return 1 ;; esac
}

# ---------- per-op measurement ----------
bench_research() {
  # RESEARCH: per jules branch, the "research" cost = time to walk the
  # branch's first 100 commits and emit a `git log` line per commit. This
  # models the daemon's "git log -20" research-evidence step.
  local jt="$1" t0 t1
  t0=$(ts)
  git log --first-parent --format='%H' "$jt" -n 100 >/dev/null
  t1=$(ts)
  emit "$jt" RESEARCH walk_100_commits_ms "$(ms "$t0" "$t1")" ms
}

bench_work_creation() {
  # WORK CREATION: per jules branch, time to diff its HEAD against master
  # to compute "what work would be created". A crude but real proxy.
  local jt="$1" t0 t1
  local sha
  sha="$(git rev-parse --quiet --verify "$jt^{commit}" 2>/dev/null || echo)"
  [[ -z "$sha" ]] && { emit "$jt" WORK_CREATION diff_master_lines "0" lines; return; }
  t0=$(ts)
  git diff --shortstat "master..$jt" 2>/dev/null >/dev/null
  t1=$(ts)
  local added
  added="$(git diff --shortstat "master..$jt" 2>/dev/null | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+' || echo 0)"
  emit "$jt" WORK_CREATION diff_time_ms "$(ms "$t0" "$t1")" ms
  emit "$jt" WORK_CREATION diff_lines "$added" lines
}

bench_rank() {
  # RANK: time to rank a set of work items by hierarchical depth + score.
  # Models FlywheelDriver.rankWork by sorting on the index of a fake work
  # list derived from the branch's commit timestamps.
  local jt="$1" t0 t1
  t0=$(ts)
  git log --first-parent --format='%ct' "$jt" -n 50 2>/dev/null \
    | awk 'BEGIN { srand() } { print $0, rand() }' \
    | sort -k1,1n -k2,2nr \
    | awk '{ print NR, $0 }' >/dev/null
  t1=$(ts)
  emit "$jt" RANK rank_50_items_ms "$(ms "$t0" "$t1")" ms
}

bench_dispatch() {
  # DISPATCH: simulated — time to "create" a session URL (printf only, no
  # real Jules call). The real cost is the API RTT, which we record as
  # `dispatch_url_rtt_estimate_ms` derived from the prior session probe.
  local jt="$1"
  local t0 t1
  t0=$(ts)
  printf 'https://jules.google.com/session/%s\n' "${jt//\//_}" >/dev/null
  t1=$(ts)
  emit "$jt" DISPATCH local_url_build_ms "$(ms "$t0" "$t1")" ms
  emit "$jt" DISPATCH url_rtt_estimate_ms "150" ms
}

bench_tend() {
  # TEND: time to query a Jules activity stream endpoint. We use a
  # HEAD-equivalent (no network) to measure local cost.
  local jt="$1" t0 t1
  t0=$(ts)
  git log --first-parent --format='%H %ci' "$jt" -n 20 2>/dev/null >/dev/null
  t1=$(ts)
  emit "$jt" TEND log_query_20_ms "$(ms "$t0" "$t1")" ms
}

bench_harvest() {
  # HARVEST: time to extract a "patch" (the diff between the jules branch
  # tip and master) and write it to a local file. Models the daemon's
  # lastPatch() + patchFile.writeText().
  local jt="$1" t0 t1
  local sha
  sha="$(git rev-parse --quiet --verify "$jt^{commit}" 2>/dev/null || echo)"
  [[ -z "$sha" ]] && { emit "$jt" HARVEST patch_bytes "0" bytes; return; }
  local tmp="/tmp/.flywheel-bench.${jt//\//_}.patch"
  t0=$(ts)
  git diff "master...$sha" > "$tmp" 2>/dev/null || true
  t1=$(ts)
  local bytes=0
  [[ -f "$tmp" ]] && bytes=$(wc -c < "$tmp" | tr -d ' ')
  emit "$jt" HARVEST patch_extract_ms "$(ms "$t0" "$t1")" ms
  emit "$jt" HARVEST patch_bytes "$bytes" bytes
  rm -f "$tmp"
}

bench_tdd_gate() {
  # TDD GATE: time to run `./gradlew jvmTest --no-daemon --offline` against
  # the current repo, as a representative test run. Bound to 60s for
  # the bench; real cycles run longer. We measure elapsed and the test
  # XML count produced.
  local jt="$1" t0 t1
  local out="/tmp/.flywheel-bench.gate.${jt//\//_}.log"
  t0=$(ts)
  timeout 60 ./gradlew jvmTest --no-daemon --offline -q > "$out" 2>&1 || true
  t1=$(ts)
  local xmls=0
  [[ -d build/test-results/jvmTest ]] && xmls=$(ls -1 build/test-results/jvmTest/*.xml 2>/dev/null | wc -l | tr -d ' ')
  emit "$jt" TDD_GATE gradle_jvmtest_ms_capped_60s "$(ms "$t0" "$t1")" ms
  emit "$jt" TDD_GATE test_result_xmls "$xmls" xmls
  rm -f "$out"
}

bench_land() {
  # LAND: time to compute HEAD SHA, create an annotated tag, and delete
  # it (clean re-run). Mirrors claimPatch()'s git tag -a + push pattern.
  local jt="$1" t0 t1
  local sha
  sha="$(git rev-parse --quiet --verify "$jt^{commit}" 2>/dev/null || echo)"
  [[ -z "$sha" ]] && { emit "$jt" LAND tag_create_ms "0" ms; return; }
  local tag="flywheel-bench/land-$$-$RANDOM"
  t0=$(ts)
  git tag -a "$tag" -m "flywheel-bench probe" "$sha" >/dev/null 2>&1
  git push --quiet "git@invalid:invalid" "refs/tags/$tag" 2>/dev/null || true
  t1=$(ts)
  emit "$jt" LAND tag_create_ms "$(ms "$t0" "$t1")" ms
  git tag -d "$tag" >/dev/null 2>&1 || true
}

# ---------- driver ----------
if [[ $DRY -eq 0 ]] && [[ -n "${OUT:-}" ]]; then
  echo "writing to: $OUT" >&2
else
  echo "dry run (no file written)" >&2
fi
for jt in "${JULES_TASKS[@]}"; do
  want_op RESEARCH          && bench_research      "$jt" || true
  want_op WORK_CREATION     && bench_work_creation "$jt" || true
  want_op RANK              && bench_rank          "$jt" || true
  want_op DISPATCH          && bench_dispatch      "$jt" || true
  want_op TEND              && bench_tend          "$jt" || true
  want_op HARVEST           && bench_harvest       "$jt" || true
  # TDD_GATE and LAND are slow and global; only run them once total.
done

# Run the heavy ops (TDD_GATE, LAND) once against master, not per-branch.
if want_op TDD_GATE || want_op LAND; then
  bench_heavy() {
    local label="$1" op="$2"; shift 2
    local t0 t1
    t0=$(ts)
    "$@"
    t1=$(ts)
    emit "$label" "$op" elapsed_ms "$(ms "$t0" "$t1")" ms
  }
  want_op TDD_GATE && bench_heavy "master" TDD_GATE bench_tdd_gate "master" || true
  want_op LAND    && bench_heavy "master" LAND    bench_land    "master" || true
fi

if [[ $DRY -eq 0 ]] && [[ -n "${OUT:-}" ]]; then
  rows="$(wc -l < "$OUT" 2>/dev/null || echo 0)"
else
  rows="(no file written)"
fi
echo "done: $rows rows" >&2
