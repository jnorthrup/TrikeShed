#!/bin/bash
# Launch OroborosDaemon straight on the JVM: no Gradle in the run path. Build first with
#   ./gradlew -q --no-daemon jvmJar stageDaemonLib
# Env passes through (TRIKESHED_BELIEF_BAG=1 turns on the belief bag the Curate page needs).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JAVA="${JAVA_HOME:-$HOME/.sdkman/candidates/java/current}/bin/java"
# Gradle overwrites these jars in place. A running ZipFile retains offsets into
# the old bytes, so each daemon owns a snapshot until its shutdown has drained.
RUNTIME="$(mktemp -d "${TMPDIR:-/tmp}/trikeshed-oroboros.XXXXXXXX")"
RUNTIME_JARS=()
cleanup() {
  for artifact in "${RUNTIME_JARS[@]}"; do rm -f -- "$artifact"; done
  rmdir -- "$RUNTIME"
}
trap cleanup EXIT
CP=""
for j in "$ROOT/build/libs/TrikeShed-jvm-0.1.0-SNAPSHOT.jar" "$ROOT"/build/staging/lib/*.jar; do
  target="$RUNTIME/$(basename "$j")"
  RUNTIME_JARS+=("$target")
  # APFS clone avoids a second physical copy; other filesystems use ordinary cp.
  if ! cp -c "$j" "$target" 2>/dev/null; then cp "$j" "$target"; fi
  CP="${CP:+$CP:}$target"
done
cd "$ROOT"
"$JAVA" -Xmx8g --add-modules=jdk.internal.vm.ci --enable-native-access=ALL-UNNAMED -cp "$CP" \
  borg.trikeshed.daemon.OroborosDaemon "$@" &
DAEMON_PID=$!
forward_signal() { kill -s "$1" "$DAEMON_PID" 2>/dev/null || true; }
trap 'forward_signal TERM' TERM
trap 'forward_signal INT' INT
trap 'forward_signal HUP' HUP
set +e
wait "$DAEMON_PID"
result=$?
# A trapped signal interrupts wait before Java's shutdown hooks have finished.
while kill -0 "$DAEMON_PID" 2>/dev/null; do
  wait "$DAEMON_PID"
  result=$?
done
exit "$result"
