#!/bin/bash
# Launch OroborosDaemon straight on the JVM: no Gradle in the run path. Build first with
#   ./gradlew -q --no-daemon jvmJar stageDaemonLib
# Env passes through (TRIKESHED_BELIEF_BAG=1 turns on the belief bag the Curate page needs).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JAVA="${JAVA_HOME:-$HOME/.sdkman/candidates/java/current}/bin/java"
CP="$ROOT/build/libs/TrikeShed-jvm-0.1.0-SNAPSHOT.jar"
for j in "$ROOT"/build/staging/lib/*.jar; do CP="$CP:$j"; done
cd "$ROOT"
exec "$JAVA" -Xmx24g --add-modules=jdk.internal.vm.ci --enable-native-access=ALL-UNNAMED -cp "$CP" \
  borg.trikeshed.daemon.OroborosDaemon "$@"
